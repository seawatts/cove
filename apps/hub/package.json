{
  "bin": {
    "cove-hub": "./cove-hub"
  },
  "dependencies": {
    "@cove/api": "workspace:*",
    "@cove/db": "workspace:*",
    "@cove/drivers": "workspace:*",
    "@cove/hub-core": "workspace:*",
    "@cove/logger": "workspace:*",
    "@t3-oss/env-core": "catalog:",
    "@trpc/server": "catalog:",
    "superjson": "catalog:",
    "zod": "catalog:"
  },
  "description": "Cove Hub - Core daemon for home automation",
  "devDependencies": {
    "@cove/tsconfig": "workspace:*",
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  },
  "license": "MIT",
  "main": "./src/index.ts",
  "name": "@cove/hub",
  "private": false,
  "scripts": {
    "build": "bun build ./src/index.ts --compile --outfile cove-hub",
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test src/__tests__",
    "test:coverage": "bun test --coverage src/__tests__",
    "test:watch": "bun test --watch src/__tests__",
    "typecheck": "tsc --noEmit --emitDeclarationOnly false"
  },
  "type": "module",
  "version": "0.1.0"
}